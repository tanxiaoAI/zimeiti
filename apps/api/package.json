{
  "name": "ai-media-assistant-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env src/server.js",
    "start": "NODE_ENV=production node --env-file=../../.env src/server.js",
    "build": "cd ../../ && npm install --include=dev && npm run build && rm -rf apps/api/dist && cp -R apps/web/dist apps/api/dist",
    "lint": "node -c src/server.js"
  },
  "dependencies": {
    "@ai-media/shared": "*",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  }
}
